# Copy to .env (gitignored) and adjust. Every value below is the default used when unset.

# --- Storage -----------------------------------------------------------------
# Host folder mounted at /app/data: announcements (~2 MB/month compressed), PDFs, prices, deals.json.
# Keep it out of cloud-synced folders (OneDrive/Dropbox) — e.g. IDX_DATA_DIR=D:/idx-data
IDX_DATA_DIR=./data
NEO4J_DATA_DIR=./neo4j_data

# --- Image / ports -----------------------------------------------------------
IDX_IMAGE=idx-bei-app
APP_PORT=8000

# --- Neo4j (only with: docker compose --profile graph up -d) ------------------
# Pin a version (e.g. neo4j:5) once you have data; Neo4j cannot open data from a newer version.
NEO4J_IMAGE=neo4j:latest
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Scheduled worker (Asia/Jakarta time, IDX trading days) ---------------------
# Announcements: every N minutes 06:00-23:00 on trading days, every OFF minutes otherwise.
WORKER_ANN_MINUTES=10
WORKER_ANN_OFF_MINUTES=60
# Daily jobs (HH:MM); each retries until 23:00 if it fails.
WORKER_PRICES_AT=18:30
WORKER_SCREEN_AT=19:00
WORKER_DOSSIERS_AT=20:00
# Weekly cleanup on Sundays (compress closed months, prune old PDFs/outputs, trim logs).
WORKER_CLEANUP_AT=03:00
# Start dates for the screen and the deal dossiers.
WORKER_SCREEN_FROM=2025-01-01
WORKER_DOSSIER_FROM=2025-01-01

# --- Broker flow (bring your own API key) --------------------------------------
# Per-stock broker summaries from YOUR OWN subscription; data is cached under data/brokerflow/ on this
# machine only. Use it within your provider's terms (no redistribution). One key is enough.
#   Invezgo developer plan: 1 request per stock per trading day (2 with BROKERFLOW_FOREIGN=1)
#   Sectors Insider plan:   1 credit per stock per 14 days, foreign split included
INVEZGO_API_KEY=
SECTORS_API_KEY=
# invezgo | sectors (default: whichever key is set, Invezgo first)
BROKERFLOW_PROVIDER=
BROKERFLOW_FOREIGN=0
# Max provider requests per day across CLI, dashboard and worker
BROKERFLOW_DAILY_CAP=500
# Worker job (trading days): extra tickers, top-N leads to include, calendar days kept cached
WORKER_BROKERFLOW_AT=19:30
BROKERFLOW_WATCH=
BROKERFLOW_LEADS_TOP=20
BROKERFLOW_DAYS=90
